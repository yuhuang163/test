   <item>
    <widget class="QGroupBox" name="groupBox_timing">
     <property name="title">
      <string>等待时间</string>
     </property>
     <layout class="QFormLayout" name="formLayout_timing">
      <item row="0" column="0">
       <widget class="QLabel" name="label_delayBefore">
        <property name="text">
