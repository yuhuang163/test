<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TestCaseEditDialog</class>
 <widget class="QDialog" name="TestCaseEditDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>868</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>测试项配置</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_root">
   <item>
    <widget class="QGroupBox" name="groupBox_meta">
     <property name="title">
      <string>测试项信息</string>
     </property>
     <layout class="QFormLayout" name="formLayout_meta">
      <item row="0" column="0">
       <widget class="QLabel" name="label_caseName">
        <property name="toolTip">
         <string>流程块、日志与配置文件名（支持中文，勿含 \ / : * ? &quot; &lt; &gt; |）</string>
        </property>
        <property name="text">
         <string>名称</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="lineEdit_caseName">
        <property name="placeholderText">
         <string>例如：读取电量</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_mesTag">
        <property name="toolTip">
         <string>必填；勾选MES后本步结果在系统中的英文项名，须与MES约定一致，且同一测试流程内不可重复</string>
        </property>
        <property name="text">
         <string>上报MES的字段</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="lineEdit_mesTag">
        <property name="placeholderText">
         <string>必填，例如：BATTERY_INFO</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="checkBox_promptEnabled">
        <property name="text">
         <string>测试时弹出操作提示</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="checkBox_promptOnly">
        <property name="text">
         <string>不发送指令（PromptOnly）</string>
        </property>
        <property name="toolTip">
         <string>勾选「测试时弹出操作提示」+ 本项：
· 下方卡控未开：弹窗有「是」，点「是」即过本步（纯确认）。
· 下方卡控已开：弹窗无按钮，同步等待上报匹配后自动下一步（防误点）。
不勾选本项：弹窗提示的同时仍会执行下方测试指令。</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="label_promptText">
        <property name="text">
         <string>提示文字</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QPlainTextEdit" name="plainTextEdit_promptText">
        <property name="maximumSize">
         <size>
          <width>16777215</width>
          <height>80</height>
         </size>
        </property>
        <property name="placeholderText">
         <string>例如：请观察电量是否上升</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
