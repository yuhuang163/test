          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="toolTip">
         <string>sendCommandWithRetry 每次等待设备响应的间隔；超时后按 test_base 规则重试。未配置的旧 ini 运行时仍为：无卡控 3000、有卡控 8000。</string>
        </property>
        <property name="text">
         <string>指令超时(毫秒)</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="spinBox_commandTimeout">
        <property name="toolTip">
         <string>对应 ini：Timing/CommandTimeoutMs</string>
        </property>
        <property name="minimum">
         <number>100</number>
        </property>
        <property name="maximum">
         <number>600000</number>
        </property>
        <property name="value">
         <number>3000</number>
        </property>
       </widget>
      </item>
