<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!--
      远控 WebSocket：不要在站点 web.config 写 <proxy>/<webSocket>（默认被 IIS 锁定 → 500.19）。
      在服务器级配置：① Web 服务器 → 应用程序开发 → WebSocket 协议
      ② IIS 根节点 → ARR → Server Proxy Settings → Enable proxy → iisreset
      ③ 勿在重写规则里把 HTTP_SEC_WEBSOCKET_EXTENSIONS 设为 ""（会触发 uvicorn 400）
    -->

    <!-- ⭐关键：上传大小限制 -->
    <security>
      <requestFiltering>
        <!-- 500MB；远控 JWT 查询串也可能偏长，放宽 query -->
        <requestLimits maxAllowedContentLength="524288000" maxQueryString="8192" maxUrl="8192" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <!--
            不要把 Sec-WebSocket-Extensions 设成空字符串：
            ARR 会转发「空头」到 uvicorn，报 400：
            invalid Sec-WebSocket-Extensions header: expected token at 0 in .
            浏览器压缩扩展改由 API（uvicorn）关闭 permessage-deflate 处理。
          -->
          <action type="Rewrite" url="http://127.0.0.1:8800/api/{R:1}" appendQueryString="true" />
        </rule>

        <!-- FastAPI Swagger / OpenAPI（须在 SPA 兜底规则之前） -->
        <rule name="API Docs" stopProcessing="true">
          <match url="^docs(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8800/docs{R:1}" />
        </rule>
        <rule name="OpenAPI JSON" stopProcessing="true">
          <match url="^openapi\.json$" />
          <action type="Rewrite" url="http://127.0.0.1:8800/openapi.json" />
        </rule>
        <rule name="API ReDoc" stopProcessing="true">
          <match url="^redoc(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8800/redoc{R:1}" />
        </rule>
        <rule name="API Health" stopProcessing="true">
          <match url="^health$" />
          <action type="Rewrite" url="http://127.0.0.1:8800/health" />
        </rule>

        <rule name="SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <!-- 部分 IIS 未注册 .ico 时，favicon 会 404 落到 SPA/地球图标 -->
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
    </staticContent>

  </system.webServer>
</configuration>
