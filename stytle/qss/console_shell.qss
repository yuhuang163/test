/* Momcozy 控制台壳层：贴合 device-control-panel-final.html */
QMainWindow {
	background-color: #f3f8ff;
	font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
	font-size: 13px;
	color: #243654;
}

QWidget#centralwidget,
QWidget#consoleShell,
QWidget#consoleConnectPage,
QWidget#consoleSideBody,
QWidget#consoleHeader,
QWidget#consoleFlowHost {
	background: transparent;
}

QWidget#consoleBg {
	background-color: #eef5ff;
}

QWidget#consoleSidebar {
	background: transparent;
	border-right: 1px solid rgba(213, 226, 243, 180);
}

QWidget#consoleSideFade {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
		stop:0 rgba(247, 251, 255, 235),
		stop:0.32 rgba(247, 251, 255, 150),
		stop:0.62 rgba(232, 242, 255, 40),
		stop:1 rgba(232, 242, 255, 0));
}

QFrame#consoleBrandLine {
	background: rgba(213, 226, 243, 160);
	border: 0;
	max-height: 1px;
}

QLabel#consoleBrandTitle {
	font-size: 16px;
	font-weight: 700;
	color: #243654;
}

QLabel#consoleBrandSub {
	font-size: 13px;
	color: #71839d;
	padding-bottom: 4px;
}

QPushButton#consoleNavConnect,
QPushButton#consoleNavBiz,
QPushButton#consoleNavPeriph,
QPushButton#consoleNavDongle,
QPushButton#consoleNavOta,
QPushButton#consoleNavMisc {
	text-align: left;
	padding: 0 12px 0 10px;
	min-height: 44px;
	max-height: 44px;
	border: 0;
	border-radius: 13px;
	color: #4f6480;
	background: rgba(255, 255, 255, 150);
	font-size: 13px;
	font-weight: 600;
}

QPushButton#consoleNavConnect:hover,
QPushButton#consoleNavBiz:hover,
QPushButton#consoleNavPeriph:hover,
QPushButton#consoleNavDongle:hover,
QPushButton#consoleNavOta:hover,
QPushButton#consoleNavMisc:hover {
	background: rgba(255, 255, 255, 210);
	color: #2563eb;
}

QPushButton#consoleNavConnect:pressed,
QPushButton#consoleNavBiz:pressed,
QPushButton#consoleNavPeriph:pressed,
QPushButton#consoleNavDongle:pressed,
QPushButton#consoleNavOta:pressed,
QPushButton#consoleNavMisc:pressed {
	background: #d7e6fb;
	color: #1d4ed8;
}

QPushButton#consoleNavConnect:checked,
QPushButton#consoleNavBiz:checked,
QPushButton#consoleNavPeriph:checked,
QPushButton#consoleNavDongle:checked,
QPushButton#consoleNavOta:checked,
QPushButton#consoleNavMisc:checked {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #62a3fb, stop:1 #3b82f6);
	color: #ffffff;
}

QPushButton#consoleNavConnect:checked:pressed,
QPushButton#consoleNavBiz:checked:pressed,
QPushButton#consoleNavPeriph:checked:pressed,
QPushButton#consoleNavDongle:checked:pressed,
QPushButton#consoleNavOta:checked:pressed,
QPushButton#consoleNavMisc:checked:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3b82f6, stop:1 #1d4ed8);
	color: #ffffff;
}

QLabel#consoleCare {
	color: #9bb9df;
	font-size: 9px;
	padding: 4px 4px 0 4px;
}

QLabel#consolePill,
QLabel#uartStatusLabel,
QLabel#bleStatusLabel,
QLabel#macLabel,
QLabel#cloudLoginLabel,
QLabel#WifiStatusLabel,
QLabel#consoleFactoryLabel,
QLabel#consoleBuildLabel {
	min-height: 25px;
	padding: 0 12px;
	border-radius: 12px;
	font-size: 11px;
	color: #6c7f98;
	background: rgba(255, 255, 255, 168);
	border: 1px solid rgba(219, 230, 244, 200);
}

QLabel#consoleUserChip {
	min-height: 28px;
	padding: 0 12px;
	border-radius: 14px;
	background: rgba(255, 255, 255, 180);
	color: #243654;
	font-weight: 600;
}

QToolButton#consoleIconBtn,
QToolButton#consoleSettingsBtn,
QToolButton#consoleHelpBtn {
	min-height: 28px;
	min-width: 44px;
	padding: 0 10px;
	border: 1px solid rgba(219, 230, 244, 200);
	border-radius: 14px;
	background: rgba(255, 255, 255, 180);
	color: #4f6480;
	font-weight: 600;
}

QToolButton#consoleIconBtn:hover,
QToolButton#consoleSettingsBtn:hover,
QToolButton#consoleHelpBtn:hover {
	color: #2563eb;
	background: #ffffff;
}

QToolButton#consoleIconBtn:pressed,
QToolButton#consoleSettingsBtn:pressed,
QToolButton#consoleHelpBtn:pressed {
	color: #1d4ed8;
	background: #d7e6fb;
	padding-top: 1px;
}

QWidget#consoleRail {
	background: rgba(247, 251, 255, 140);
	border-left: 1px solid rgba(213, 226, 243, 180);
}

QFrame#consoleCard,
QFrame#consoleCardDone,
QFrame#consoleCardActive,
QFrame#consoleCardReady,
QFrame#consoleCardStep1,
QFrame#consoleCardStep2,
QFrame#consoleCardStep3,
QFrame#consoleCardStep4,
QFrame#consoleStatusCard {
	background: #ffffff;
	border: 1px solid #dce8f6;
	border-radius: 16px;
}

QFrame#consoleLogCard {
	background: rgba(255, 255, 255, 210);
	border: 1px solid #dce8f6;
	border-radius: 16px;
}

QFrame#consoleCardDone,
QFrame#consoleCardStep1 {
	border: 1px solid rgba(16, 185, 129, 56);
}

QFrame#consoleCardActive,
QFrame#consoleCardStep2 {
	border: 1px solid rgba(59, 130, 246, 72);
}

QLabel#consoleCardTitle,
QLabel#consoleStep1Title,
QLabel#consoleStep2Title,
QLabel#consoleStep3Title,
QLabel#consoleStep4Title,
QLabel#consoleStatusTitle,
QLabel#consoleLogTitle {
	font-size: 14px;
	font-weight: 700;
	color: #243654;
}

QLabel#consoleFieldLabel,
QLabel#consoleFieldComLabel,
QLabel#consoleFieldResetLabel,
QLabel#consoleFieldNameLabel,
QLabel#consoleFieldRssiLabel,
QLabel#consoleFieldPickLabel,
QLabel#consoleFieldMacLabel,
QLabel#consoleFieldGetMacLabel,
QLabel#consoleFieldSnLabel {
	color: #71839d;
	font-size: 12px;
	font-weight: 600;
}

QLabel#consoleMetaLine,
QLabel#product_sn,
QLabel#board_sn,
QLabel#sub_pid,
QLabel#sku_id {
	color: #4f6480;
	font-size: 12px;
}

QLabel#consoleStepBadge,
QLabel#consoleStep1Badge,
QLabel#consoleStep2Badge,
QLabel#consoleStep3Badge,
QLabel#consoleStep4Badge {
	min-width: 22px;
	min-height: 22px;
	border-radius: 11px;
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #60a5fa, stop:1 #3b82f6);
	color: #ffffff;
	font-weight: 700;
	font-size: 12px;
	qproperty-alignment: AlignCenter;
}

QLabel#consoleStepStatusOk {
	padding: 2px 10px;
	border-radius: 12px;
	background: #e5f8f3;
	color: #178269;
	font-size: 11px;
	font-weight: 600;
}

QLabel#consoleStepStatusActive {
	padding: 2px 10px;
	border-radius: 12px;
	background: #eaf3ff;
	color: #2563eb;
	font-size: 11px;
	font-weight: 600;
}

QLabel#consoleStepStatusPending {
	padding: 2px 10px;
	border-radius: 12px;
	background: #eef3f9;
	color: #71839d;
	font-size: 11px;
	font-weight: 600;
}

QFrame#consoleFlowGuide {
	background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(239, 246, 255, 235), stop:1 rgba(255, 255, 255, 224));
	border: 1px solid rgba(59, 130, 246, 40);
	border-radius: 14px;
}

QLabel#consoleFlowNodeDone {
	border-radius: 15px;
	background: #e5f8f3;
	color: #178269;
	font-weight: 700;
	border: 2px solid rgba(16, 185, 129, 110);
}

QLabel#consoleFlowNodeActive {
	border-radius: 15px;
	background: #eaf3ff;
	color: #2563eb;
	font-weight: 700;
	border: 2px solid #3b82f6;
}

QLabel#consoleFlowNodePending,
QLabel#consoleFlowNodePending3,
QLabel#consoleFlowNodePending4 {
	border-radius: 15px;
	background: #eef3f9;
	color: #71839d;
	font-weight: 700;
	border: 2px solid #dce8f6;
}

QLabel#consoleFlowLabel,
QLabel#consoleFlowLabel1,
QLabel#consoleFlowLabel2,
QLabel#consoleFlowLabel3,
QLabel#consoleFlowLabel4 {
	font-size: 11px;
	font-weight: 600;
	color: #71839d;
}

QFrame#consoleFlowLine,
QFrame#consoleFlowLine2,
QFrame#consoleFlowLine3 {
	background: #dce8f6;
	border: 0;
}

QFrame#consoleFlowLineActive {
	background: #93c5fd;
	border: 0;
}

QLabel#consoleFlowHint {
	font-size: 12px;
	color: #243654;
	padding-top: 4px;
	border-top: 1px solid rgba(59, 130, 246, 30);
}

QLabel#consoleSearchHint,
QLabel#consolePickHint {
	color: #9aabc0;
	font-size: 12px;
}

QGroupBox#groupBox_5,
QGroupBox#verticalGroupBox {
	background: transparent;
	border: 0;
	margin-top: 0;
	padding: 0;
}

QLabel#consolePromo {
	background: transparent;
	border: 0;
	border-bottom-left-radius: 16px;
	border-bottom-right-radius: 16px;
}

QGroupBox {
	background: #ffffff;
	border: 1px solid #dce8f6;
	border-radius: 16px;
	margin-top: 14px;
	padding: 10px 8px 8px 8px;
	font-weight: 700;
	color: #243654;
}

QGroupBox::title {
	subcontrol-origin: margin;
	left: 12px;
	padding: 0 6px;
	color: #243654;
	font-weight: 700;
}

QFrame#consoleSeg,
QFrame#consoleSegReset {
	background: #eef3f9;
	border: 1px solid #dce8f6;
	border-radius: 12px;
}

QFrame#consoleSeg QPushButton,
QFrame#consoleSegReset QPushButton {
	min-height: 0;
	max-height: 30px;
	min-width: 48px;
	padding: 0 14px;
	border: 0;
	border-radius: 9px;
	background: transparent;
	color: #71839d;
}

QFrame#consoleSeg QPushButton:hover,
QFrame#consoleSegReset QPushButton:hover {
	color: #243654;
	background: rgba(255, 255, 255, 0.45);
}

QFrame#consoleSeg QPushButton:pressed,
QFrame#consoleSegReset QPushButton:pressed {
	color: #1d4ed8;
	background: #d7e6fb;
}

QFrame#consoleSeg QPushButton[segActive="true"],
QFrame#consoleSegReset QPushButton[segActive="true"] {
	background: #6366f1;
	color: #ffffff;
}

QFrame#consoleSeg QPushButton[segActive="true"]:hover,
QFrame#consoleSegReset QPushButton[segActive="true"]:hover {
	background: #4f46e5;
	color: #ffffff;
}

QFrame#consoleSeg QPushButton[segActive="true"]:pressed,
QFrame#consoleSegReset QPushButton[segActive="true"]:pressed {
	background: #4338ca;
	color: #ffffff;
}

QFrame#consoleSeg QPushButton[segDanger="true"],
QFrame#consoleSegReset QPushButton[segDanger="true"] {
	background: #ef5b5b;
	color: #ffffff;
}

QFrame#consoleSeg QPushButton[segDanger="true"]:hover,
QFrame#consoleSegReset QPushButton[segDanger="true"]:hover {
	background: #e14a4a;
	color: #ffffff;
}

QFrame#consoleSeg QPushButton[segDanger="true"]:pressed,
QFrame#consoleSegReset QPushButton[segDanger="true"]:pressed {
	background: #c93434;
	color: #ffffff;
}

QPushButton {
	min-height: 36px;
	padding: 0 14px;
	border: 0;
	border-radius: 10px;
	background: #eef3f9;
	color: #243654;
	font-weight: 600;
}

QPushButton:hover {
	background: #e4ebf4;
}

QPushButton:pressed,
QPushButton:pressed:hover {
	background: #c5d3e6;
	padding-top: 2px;
	padding-bottom: 0px;
}

QPushButton:disabled {
	color: #9aabc0;
	background: #f3f6fb;
}

/* 对齐 HTML btnClass：primary / success / danger / secondary */
QPushButton[btnRole="primary"] {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #5ba0fb, stop:1 #3b82f6);
	color: #ffffff;
}
QPushButton[btnRole="primary"]:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4e8df8, stop:1 #2563eb);
}
QPushButton[btnRole="primary"]:pressed,
QPushButton[btnRole="primary"]:pressed:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2f6fe0, stop:1 #1d4ed8);
	padding-top: 2px;
	padding-bottom: 0px;
}
QPushButton[btnRole="success"] {
	background: #e5f8f3;
	color: #178269;
	border: 1px solid rgba(16, 185, 129, 80);
}
QPushButton[btnRole="success"]:hover {
	background: #d5f3eb;
}
QPushButton[btnRole="success"]:pressed,
QPushButton[btnRole="success"]:pressed:hover {
	background: #9ee0cd;
	color: #0f5c4a;
	padding-top: 2px;
	padding-bottom: 0px;
}
QPushButton[btnRole="danger"] {
	background: #fff0f0;
	color: #e54848;
	border: 1px solid rgba(239, 91, 91, 70);
}
QPushButton[btnRole="danger"]:hover {
	background: #ffe4e4;
}
QPushButton[btnRole="danger"]:pressed,
QPushButton[btnRole="danger"]:pressed:hover {
	background: #ffc9c9;
	color: #b42323;
	padding-top: 2px;
	padding-bottom: 0px;
}
QPushButton[btnRole="secondary"] {
	background: #eef3f9;
	color: #243654;
}
QPushButton[btnRole="secondary"]:hover {
	background: #e4ebf4;
}
QPushButton[btnRole="secondary"]:pressed,
QPushButton[btnRole="secondary"]:pressed:hover {
	background: #c5d3e6;
	padding-top: 2px;
	padding-bottom: 0px;
}

QPushButton#connectButton,
QPushButton#start_search,
QPushButton#connectProductButton,
QPushButton#getBasicInfoButton,
QPushButton#getperipheralButton {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #5ba0fb, stop:1 #3b82f6);
	color: #ffffff;
}

QPushButton#connectButton:hover,
QPushButton#start_search:hover,
QPushButton#connectProductButton:hover,
QPushButton#getBasicInfoButton:hover,
QPushButton#getperipheralButton:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4e8df8, stop:1 #2563eb);
}

QPushButton#connectButton:pressed,
QPushButton#start_search:pressed,
QPushButton#connectProductButton:pressed,
QPushButton#getBasicInfoButton:pressed,
QPushButton#getperipheralButton:pressed,
QPushButton#connectButton:pressed:hover,
QPushButton#start_search:pressed:hover,
QPushButton#connectProductButton:pressed:hover,
QPushButton#getBasicInfoButton:pressed:hover,
QPushButton#getperipheralButton:pressed:hover {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2f6fe0, stop:1 #1d4ed8);
	padding-top: 2px;
	padding-bottom: 0px;
}

/* 分段框内的连接/断开改走 segActive，不再整块常亮 */
QFrame#consoleSeg QPushButton#connectButton,
QFrame#consoleSeg QPushButton#disconnectButton {
	background: transparent;
	color: #71839d;
}

QFrame#consoleSeg QPushButton#connectButton[segActive="true"] {
	background: #6366f1;
	color: #ffffff;
}

QFrame#consoleSeg QPushButton#disconnectButton[segDanger="true"] {
	background: #ef5b5b;
	color: #ffffff;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
	min-height: 32px;
	border: 1px solid #dce8f6;
	border-radius: 10px;
	background: #f7fafe;
	color: #243654;
	padding: 0 8px;
	selection-background-color: #3b82f6;
	selection-color: #ffffff;
}

QComboBox {
	padding-right: 32px;
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: center right;
	width: 32px;
	border: 0;
	background: transparent;
}

QComboBox::down-arrow {
	image: url(:/stytle/picture/combo-down-arrow.png);
	width: 18px;
	height: 18px;
}

QComboBox QAbstractItemView {
	background: #ffffff;
	border: 1px solid #dce8f6;
	selection-background-color: #eaf3ff;
	selection-color: #2563eb;
}

QSpinBox, QDoubleSpinBox {
	padding-right: 18px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
	subcontrol-origin: border;
	subcontrol-position: top right;
	width: 16px;
	height: 14px;
	border: 0;
	background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
	subcontrol-origin: border;
	subcontrol-position: bottom right;
	width: 16px;
	height: 14px;
	border: 0;
	background: transparent;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
	image: url(:/stytle/picture/combo-up-arrow.png);
	width: 8px;
	height: 5px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
	image: url(:/stytle/picture/combo-down-arrow.png);
	width: 8px;
	height: 5px;
}

QWidget#consoleWorkPage,
QScrollArea#debugTabScrollArea,
QScrollArea#consoleConnectScroll {
	background: transparent;
	border: 0;
}

QWidget#consoleWorkPage QGroupBox {
	margin-top: 8px;
	padding: 10px 8px 8px 8px;
	background: #ffffff;
	border: 1px solid #dce8f6;
	border-radius: 14px;
}

QWidget#consoleBusinessGridHost QGroupBox,
QTabWidget#tabWidget_debug_production QGroupBox {
	background: #ffffff;
	border: 1px solid #dce8f6;
	border-radius: 14px;
	min-height: 120px;
}

QWidget#consoleWorkPage QWidget#groupBox_business_meta QLabel {
	color: #5b6f88;
	font-size: 12px;
	min-width: 52px;
}

QWidget#consoleWorkPage QWidget#groupBox_business_meta QPushButton {
	min-width: 52px;
	padding: 0 10px;
	font-size: 12px;
}

QWidget#consoleWorkPage QWidget#groupBox_business_meta QPushButton:pressed,
QWidget#consoleWorkPage QWidget#groupBox_business_meta QPushButton:pressed:hover {
	padding-top: 2px;
	padding-bottom: 0px;
}

QWidget#consoleWorkPage QWidget#groupBox_business_meta QLineEdit {
	min-width: 0;
}

QWidget#consoleDongleAtGrid QGroupBox {
	background: #ffffff;
	border: 1px solid #dce8f6;
	border-radius: 14px;
	min-height: 120px;
}

QFrame#consoleCardStep1,
QFrame#consoleCardStep2,
QFrame#consoleCardStep4 {
	min-height: 168px;
}

/* 实物感加减 / 模式 / 加热 */
QPushButton[physPad="true"] {
	min-width: 52px;
	max-width: 72px;
	min-height: 40px;
	max-height: 40px;
	padding: 0 10px;
	border-radius: 20px;
	font-size: 14px;
	font-weight: 700;
	background: #ffffff;
	border: 1px solid #d0deef;
	color: #243654;
}
QPushButton[physPad="true"]:hover {
	background: #eaf3ff;
	border-color: #93c5fd;
	color: #2563eb;
}
QPushButton[physPad="true"]:pressed,
QPushButton[physPad="true"]:pressed:hover {
	background: #bfdbfe;
	border-color: #3b82f6;
	color: #1d4ed8;
	padding-top: 2px;
	padding-bottom: 0px;
}
QPushButton#physHeatSend[physPad="true"],
QPushButton#physSuctionMode[physPad="true"] {
	min-width: 64px;
	max-width: 88px;
}
QLabel#physHeatLevelLab,
QLabel#physSuctionLevelLab {
	min-width: 40px;
	color: #243654;
	font-weight: 700;
	font-size: 14px;
}

QWidget#consoleWorkPage QGroupBox QGroupBox {
	margin-top: 6px;
	background: #f7fafe;
	border: 1px solid #e7eef7;
}

QWidget#consoleWorkPage QPushButton {
	min-height: 32px;
	max-height: 32px;
	min-width: 84px;
	padding: 0 10px;
	font-size: 12px;
}

QWidget#consoleWorkPage QPushButton:pressed,
QWidget#consoleWorkPage QPushButton:pressed:hover {
	padding-top: 2px;
	padding-bottom: 0px;
}

QTabWidget#tabWidget_debugInner {
	min-height: 240px;
}

QWidget#consoleWorkPage QComboBox,
QWidget#consoleWorkPage QLineEdit,
QWidget#consoleWorkPage QSpinBox,
QWidget#consoleWorkPage QDoubleSpinBox {
	min-height: 32px;
	max-height: 32px;
}

QWidget#consoleWorkPage QSpinBox,
QWidget#consoleWorkPage QDoubleSpinBox {
	min-width: 64px;
}

QWidget#consoleWorkPage QLabel {
	color: #5b6f88;
	font-size: 12px;
}

QCheckBox {
	color: #243654;
	spacing: 8px;
}

QCheckBox::indicator {
	width: 18px;
	height: 18px;
	border-radius: 9px;
	border: 1px solid #dce8f6;
	background: #ffffff;
}

QCheckBox::indicator:checked {
	background: #3b82f6;
	border: 1px solid #3b82f6;
}

QSlider::groove:horizontal {
	height: 6px;
	border-radius: 3px;
	background: #dce8f6;
}

QSlider::handle:horizontal {
	width: 14px;
	height: 14px;
	margin: -5px 0;
	border-radius: 7px;
	background: #3b82f6;
}

QTabWidget::pane {
	border: 0;
	background: transparent;
	top: 0;
}

QTabWidget#consoleLogTabs {
	background: transparent;
	border: 0;
}

QTabBar::tab {
	min-height: 28px;
	padding: 4px 14px;
	margin: 0 4px 6px 0;
	border: 1px solid #dce8f6;
	border-radius: 14px;
	background: #ffffff;
	color: #71839d;
}

QTabBar::tab:selected {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #62a3fb, stop:1 #3b82f6);
	color: #ffffff;
	border: 0;
}

QTabBar::tab:hover:!selected {
	color: #2563eb;
	background: #eaf3ff;
}

QTabBar::tab:pressed {
	background: #d7e6fb;
	color: #1d4ed8;
}

QTabBar::tab:selected:pressed {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3b82f6, stop:1 #1d4ed8);
	color: #ffffff;
}

QTableView, QTableWidget, QTreeView, QListView {
	background: #ffffff;
	border: 1px solid #dce8f6;
	border-radius: 10px;
	gridline-color: #edf3fa;
	alternate-background-color: #f7fafe;
	color: #243654;
}

QHeaderView::section {
	background: #f7fafe;
	border: 0;
	border-bottom: 1px solid #dce8f6;
	padding: 6px 8px;
	color: #71839d;
	font-weight: 600;
}

QWidget#consoleLogHostPage,
QWidget#consoleLogDonglePage {
	background: transparent;
}

QPlainTextEdit#log,
QPlainTextEdit#msgEdit {
	background: rgba(255, 255, 255, 184);
	border: 1px solid #dce8f6;
	border-radius: 10px;
	padding: 8px 12px;
	font-family: Consolas, "Cascadia Mono", monospace;
	font-size: 11px;
	color: #334155;
}

QScrollBar:vertical {
	width: 6px;
	background: transparent;
	margin: 0;
}

QScrollBar::handle:vertical {
	background: rgba(148, 178, 210, 160);
	border-radius: 3px;
	min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	height: 0;
	background: transparent;
}

QScrollBar:horizontal {
	height: 6px;
	background: transparent;
}

QScrollBar::handle:horizontal {
	background: rgba(148, 178, 210, 160);
	border-radius: 3px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
	width: 0;
}

QMenu {
	background: #ffffff;
	border: 1px solid #dce8f6;
	color: #243654;
}

QMenu::item:selected {
	background: #eaf3ff;
	color: #2563eb;
}

QLabel#consolePageTitle {
	font-size: 20px;
	font-weight: 700;
	color: #243654;
}

QLabel#consolePageSub {
	font-size: 12px;
	color: #71839d;
}

QPushButton#consoleLogClearBtn {
	min-height: 28px;
	padding: 0 12px;
	background: #eef3f9;
	color: #4f6480;
}

QPushButton#consoleLogClearBtn:hover {
	background: #e4ebf4;
	color: #243654;
}

QPushButton#consoleLogClearBtn:pressed,
QPushButton#consoleLogClearBtn:pressed:hover {
	background: #c5d3e6;
	color: #1d4ed8;
	padding-top: 2px;
	padding-bottom: 0px;
}

QLabel#consoleStatusDeviceLabel,
QLabel#consoleStatusMotorLabel,
QLabel#consoleStatusPumpLabel,
QLabel#consoleStatusValveLabel,
QLabel#consoleMetricBatteryLabel,
QLabel#consoleMetricTempLabel,
QLabel#consoleMetricCurrentLabel {
	font-size: 12px;
	color: #435873;
}

QLabel#consoleStatusDeviceState {
	color: #178269;
	font-size: 11px;
	font-weight: 600;
}

QLabel#consoleStatusMotorState,
QLabel#consoleStatusPumpState,
QLabel#consoleStatusValveState {
	color: #667b95;
	font-size: 11px;
}

QLabel#consoleMetricBatteryValue,
QLabel#consoleMetricTempValue,
QLabel#consoleMetricCurrentValue {
	color: #243654;
	font-size: 12px;
	font-weight: 700;
}

QSplitter#consoleShellSplit::handle {
	width: 12px;
	background: rgba(59, 130, 246, 18);
}

QSplitter#consoleShellSplit::handle:hover,
QSplitter#consoleShellSplit::handle:pressed {
	background: rgba(59, 130, 246, 42);
}

QScrollArea#consoleStatusScroll,
QScrollArea#consoleStatusScroll > QWidget {
	background: transparent;
	border: none;
}

QSplitter#consoleRailSplit::handle {
	height: 10px;
	background: rgba(59, 130, 246, 22);
	border-radius: 7px;
	margin: 0px 8px;
}

QSplitter#consoleRailSplit::handle:hover,
QSplitter#consoleRailSplit::handle:pressed {
	background: rgba(59, 130, 246, 46);
}
