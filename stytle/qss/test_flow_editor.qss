/* 流程编排：功能块 + 右键菜单（由 test_flow_editor 加载） */

/* 功能块行：紧凑固定高度，左勾选/序号/标题，右操作钮 */
TestCaseBlock {
  max-height: 36px;
  min-height: 36px;
  border-radius: 8px;
  font-size: 13px;
}

TestCaseBlock QToolButton#flowBlockEnable {
  border: none;
  background: transparent;
  padding: 0px;
  margin: 0px;
  min-width: 18px;
  max-width: 18px;
  min-height: 18px;
  max-height: 18px;
}

TestCaseBlock QLabel#flowBlockIndex {
  min-width: 22px;
  color: #15803d;
  font-weight: 700;
  font-size: 13px;
  background: transparent;
  border: none;
}
TestCaseBlock QLabel#flowBlockTitle {
  color: #14532d;
  font-size: 13px;
  font-weight: 500;
  background: transparent;
  border: none;
}

TestCaseBlock QWidget#flowBlockActions {
  background: transparent;
}

TestCaseBlock QWidget#flowBlockActions QToolButton {
  min-width: 26px;
  max-width: 26px;
  min-height: 26px;
  max-height: 26px;
  padding: 0px;
  margin: 0px;
  border: 1px solid #86efac;
  border-radius: 6px;
  background: #f0fdf4;
}
TestCaseBlock QWidget#flowBlockActions QToolButton:hover {
  background: #ffffff;
  border: 1px solid #4ade80;
}
TestCaseBlock QWidget#flowBlockActions QToolButton:pressed {
  background: #dcfce7;
}
TestCaseBlock QWidget#flowBlockActions QToolButton:disabled {
  background: transparent;
  border: 1px solid #d1d5db;
}

/* flowState 由 updateBlockStyle 设置 */
TestCaseBlock[flowState="normal"] {
  background: #ecfdf3;
  border: 1px solid #bbf7d0;
}
TestCaseBlock[flowState="normal"]:hover {
  background: #dcfce7;
  border: 1px solid #86efac;
}
TestCaseBlock[flowState="normal"] QLabel#flowBlockIndex {
  color: #15803d;
}
TestCaseBlock[flowState="normal"] QLabel#flowBlockTitle {
  color: #166534;
}

TestCaseBlock[flowState="selected"] {
  background: #dcfce7;
  border: 1px solid #22c55e;
}
TestCaseBlock[flowState="selected"]:hover {
  background: #bbf7d0;
  border: 1px solid #16a34a;
}
TestCaseBlock[flowState="selected"] QLabel#flowBlockIndex {
  color: #166534;
}
TestCaseBlock[flowState="selected"] QLabel#flowBlockTitle {
  color: #14532d;
  font-weight: 600;
}

TestCaseBlock[flowState="unchecked"] {
  background: #f3f4f6;
  border: 1px solid #d1d5db;
}
TestCaseBlock[flowState="unchecked"]:hover {
  background: #e5e7eb;
  border: 1px solid #9ca3af;
}
TestCaseBlock[flowState="unchecked"] QLabel#flowBlockIndex,
TestCaseBlock[flowState="unchecked"] QLabel#flowBlockTitle {
  color: #6b7280;
}

TestCaseBlock[flowState="uncheckedSelected"] {
  background: #e5e7eb;
  border: 1px solid #6b7280;
}
TestCaseBlock[flowState="uncheckedSelected"]:hover {
  background: #d1d5db;
  border: 1px solid #4b5563;
}
TestCaseBlock[flowState="uncheckedSelected"] QLabel#flowBlockIndex,
TestCaseBlock[flowState="uncheckedSelected"] QLabel#flowBlockTitle {
  color: #374151;
  font-weight: 600;
}

TestCaseBlock[flowState="blank"] {
  background: #f9fafb;
  border: 1px dashed #cbd5e1;
}
TestCaseBlock[flowState="blank"]:hover {
  background: #f3f4f6;
  border: 1px dashed #94a3b8;
}
TestCaseBlock[flowState="blank"] QLabel#flowBlockIndex,
TestCaseBlock[flowState="blank"] QLabel#flowBlockTitle {
  color: #94a3b8;
}

/* 右键菜单：深色字 + 白底，避免继承功能块 color 或全局 QMenu 浅灰字 */
QMenu {
  color: #111827;
  background-color: #ffffff;
  border: 1px solid #d1d5db;
}
QMenu::item {
  color: #111827;
  padding: 6px 28px 6px 14px;
  background: transparent;
}
QMenu::item:selected {
  color: #111827;
  background-color: #dbeafe;
}
QMenu::item:disabled {
  color: #9ca3af;
  background: transparent;
}
QMenu::separator {
  height: 1px;
  background: #e5e7eb;
  margin: 4px 8px;
}
