/* 流程编排：功能块 + 右键菜单（由 test_flow_editor 加载） */

/* 流程块公共：实体色块；勾选框靠左，文字居中 */
TestCaseBlock {
  min-height: 36px;
  padding: 8px 40px;
  border-radius: 8px;
  font-size: 13px;
  spacing: 0px;
  text-align: center;
}
TestCaseBlock::indicator {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  subcontrol-position: left center;
  subcontrol-origin: margin;
  left: 12px;
}
TestCaseBlock::indicator:checked {
  border: 1px solid #15803d;
  background: #22c55e;
}
TestCaseBlock::indicator:unchecked {
  border: 1px solid #6b7280;
  background: #9ca3af;
}

/* flowState 由 updateBlockStyle 设置 */
TestCaseBlock[flowState="normal"] {
  background: #dcfce7;
  border: 1px solid #86efac;
  color: #14532d;
}
TestCaseBlock[flowState="normal"]:hover {
  background: #bbf7d0;
  border: 1px solid #4ade80;
}

TestCaseBlock[flowState="selected"] {
  background: #bbf7d0;
  border: 2px solid #16a34a;
  color: #14532d;
  font-weight: 600;
}
TestCaseBlock[flowState="selected"]:hover {
  background: #86efac;
  border: 2px solid #15803d;
}

TestCaseBlock[flowState="unchecked"] {
  background: #e5e7eb;
  border: 1px solid #9ca3af;
  color: #4b5563;
}
TestCaseBlock[flowState="unchecked"]:hover {
  background: #d1d5db;
  border: 1px solid #6b7280;
}

TestCaseBlock[flowState="uncheckedSelected"] {
  background: #d1d5db;
  border: 2px solid #6b7280;
  color: #374151;
  font-weight: 600;
}
TestCaseBlock[flowState="uncheckedSelected"]:hover {
  background: #c4c9d1;
  border: 2px solid #4b5563;
}

TestCaseBlock[flowState="blank"] {
  background: #f3f4f6;
  border: 1px dashed #9ca3af;
  color: #6b7280;
  font-style: italic;
}
TestCaseBlock[flowState="blank"]:hover {
  background: #e5e7eb;
  border: 1px dashed #6b7280;
}

/* 右键菜单：深色字 + 白底，避免继承功能块 color 或全局 QMenu 浅灰字 */
QMenu {
  color: #111827;
  background-color: #ffffff;
  border: 1px solid #d1d5db;
}
QMenu::item {
  color: #111827;
  padding: 6px 28px 6px 14px;
  background: transparent;
}
QMenu::item:selected {
  color: #111827;
  background-color: #dbeafe;
}
QMenu::item:disabled {
  color: #9ca3af;
  background: transparent;
}
QMenu::separator {
  height: 1px;
  background: #e5e7eb;
  margin: 4px 8px;
}
