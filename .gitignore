# Python 虚拟环境（服务器/本机各自 py -3 -m venv 创建，勿入库）
factory-api/.venv/

# Node 依赖与构建产物
factory-admin/node_modules/
factory-admin/dist/

# 生产部署 zip（本机打包脚本生成）
fwq-deploy-*.zip

# 部署包运行时产物（目录本身入库，venv/数据/env 不入库）
fwq-deploy-test/factory-api/.venv/
fwq-deploy-test/factory-api/data/
fwq-deploy-test/factory-api/.env
fwq-deploy-test/factory-api/*.db

# 本地数据与密钥
factory-api/data/
factory-api/.env
factory-admin/.env
factory-admin/.env.local
